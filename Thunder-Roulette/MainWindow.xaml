<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thunder Roulette"
        Width="940"
        Height="740"
        MinWidth="820"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#17202A">
    <Grid>
        <Viewbox Margin="24" Stretch="Uniform" StretchDirection="Both"
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Width="892" Height="650" Background="#E61B2631" CornerRadius="18" Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="THUNDER ROULETTE"
                               Foreground="#FFCF55"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="War Thunder Session Director"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0" />
                    <Grid Margin="70,18,70,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Name="ProfileSelector"
                                  Height="34"
                                  FontSize="14"
                                  Padding="8,3"
                                  VerticalContentAlignment="Center" />
                        <Button Name="ManageButton"
                                Grid.Column="2"
                                Content="Manage"
                                Height="34"
                                Padding="18,3"
                                Margin="8,0,0,0"
                                Background="#34495E"
                                Foreground="White"
                                BorderThickness="0" />
                        <Button Name="ResetAllButton"
                                Grid.Column="3"
                                Content="Reset all"
                                Height="34"
                                Padding="14,3"
                                Margin="8,0,0,0"
                                Background="#7F1D1D"
                                Foreground="White"
                                BorderThickness="0" />
                        <ComboBox Name="DomainSelector"
                                  Grid.Column="1"
                                  Height="34"
                                  Margin="8,0,0,0"
                                  Padding="8,3"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  ToolTip="Choose which vehicle domain this profile is rolling." />
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,22,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="#AA0F172A"
                            Width="144"
                            Height="144"
                            CornerRadius="72"
                            Padding="5"
                            Margin="0,0,16,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Image Name="NationImage" Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Name="NationName"
                                   Text="Ready?"
                                   Foreground="White"
                                   FontSize="46"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock Name="RemainingText"
                                   Foreground="#CBD5E1"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="2,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Name="RollButton"
                                    Content="Roll up!"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Padding="24,9"
                                    Background="#FFCF55"
                                    Foreground="#17202A"
                                    BorderThickness="0" />
                            <Button Name="ResetButton"
                                    Content="New sequence"
                                    FontSize="14"
                                    Padding="18,9"
                                    Margin="10,0,0,0"
                                    Background="#34495E"
                                    Foreground="White"
                                    BorderThickness="0" />
                        </StackPanel>
                        <Border Background="#AA0F172A" CornerRadius="10" Padding="12" Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Name="RollBRButton"
                                        Content="Roll BR"
                                        Height="30"
                                        Padding="12,0"
                                        Background="#FFCF55"
                                        Foreground="#17202A"
                                        BorderThickness="0" />
                                <TextBlock Name="BRRangeText"
                                           Grid.Column="1"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Name="BRResult"
                                           Grid.Column="2"
                                           Text="&#x2014;"
                                           Foreground="White"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                <Border Background="#DD0F172A" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CHALLENGE DECK" Foreground="#FFCF55" FontSize="11" FontWeight="Bold" />
                            <TextBlock Name="ChallengeName" Text="No challenge drawn" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,3,0,0" />
                            <TextBlock Name="ChallengeObjective" Text="Draw a challenge when your squad is feeling brave." Foreground="#E2E8F0" FontSize="14" TextWrapping="Wrap" Margin="0,5,20,0" />
                            <TextBlock Name="ChallengeReward" Text="" Foreground="#86EFAC" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,20,0" />
                            <TextBlock Name="ChallengeRemainingText" Foreground="#94A3B8" FontSize="11" Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Name="RollChallengeButton"
                                Grid.Column="1"
                                Content="Draw challenge"
                                Padding="16,10"
                                Background="#7C3AED"
                                Foreground="White"
                                BorderThickness="0"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="#DD0F172A" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="FUN-MODE DECK" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" />
                            <TextBlock Name="FunModeName" Text="No fun mode drawn" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,3,0,0" />
                            <TextBlock Name="FunModeRule" Text="Draw a lineup constraint for additional questionable decisions." Foreground="#E2E8F0" FontSize="14" TextWrapping="Wrap" Margin="0,5,20,0" />
                            <TextBlock Name="FunModeRemainingText" Foreground="#94A3B8" FontSize="11" Margin="0,12,0,0" />
                        </StackPanel>
                        <Button Name="RollFunModeButton"
                                Grid.Column="1"
                                Content="Draw mode"
                                Padding="16,10"
                                Background="#0284C7"
                                Foreground="White"
                                BorderThickness="0"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Name="RollSessionButton"
                            Content="ROLL SESSION"
                            Height="46"
                            FontSize="17"
                            FontWeight="Bold"
                            Background="#FFCF55"
                            Foreground="#17202A"
                            BorderThickness="0" />
                    <Button Name="StartSessionButton"
                            Grid.Column="1"
                            Content="START SESSION"
                            Height="46"
                            Margin="10,0,0,0"
                            FontSize="17"
                            FontWeight="Bold"
                            Background="#16A34A"
                            Foreground="White"
                            BorderThickness="0"
                            IsEnabled="False" />
                </Grid>

            </Grid>
        </Border>
        </Viewbox>
    </Grid>
</Window>
