<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Challenge Editor" Width="620" Height="740" MinWidth="560" MinHeight="650"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" Background="#17202A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="CHALLENGE" FontSize="12" FontWeight="Bold" Foreground="#FFCF55" />
            <TextBlock Text="Name" Foreground="#E2E8F0" Margin="0,10,0,4" />
            <TextBox Name="ChallengeEditorName" Height="30" Padding="6,3" />
            <TextBlock Text="Objective" Foreground="#E2E8F0" Margin="0,10,0,4" />
            <TextBox Name="ChallengeEditorObjective" Height="70" Padding="6" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
            <TextBlock Text="Vehicle domain" Foreground="#E2E8F0" Margin="0,10,0,4" />
            <ComboBox Name="ChallengeEditorDomain" Height="30" DisplayMemberPath="Name" SelectedValuePath="Id" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="SESSION TRACKING" FontSize="12" FontWeight="Bold" Foreground="#7C3AED" />
            <TextBlock Text="Detailed mode uses the counters below. Simple mode records only Success or Failed."
                       Foreground="#94A3B8" Margin="0,4,0,6" />
            <ComboBox Name="ChallengeEditorRecordingMode" DisplayMemberPath="Name" SelectedValuePath="Id"
                      Height="30" Margin="0,0,0,8" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ListBox Name="ChallengeEditorTrackers" DisplayMemberPath="Summary" />
            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                <Button Name="AddCounterTrackerButton" Content="Add counter" Padding="12,7" />
                <Button Name="AddCheckboxTrackerButton" Content="Add checkbox" Padding="12,7" Margin="8,0,0,0" />
                <Button Name="EditTrackerButton" Content="Edit" Padding="12,7" Margin="8,0,0,0" />
                <Button Name="DeleteTrackerButton" Content="Delete" Padding="12,7" Margin="8,0,0,0" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SUCCESS REWARD" FontSize="12" FontWeight="Bold" Foreground="#16A34A" />
                <ComboBox Name="ChallengeEditorRewardType" DisplayMemberPath="Name" SelectedValuePath="Id"
                          Height="30" Margin="0,6,12,0" />
                <TextBlock Text="FAILED - PUNISHMENT" FontSize="12" FontWeight="Bold" Foreground="#EF4444" Margin="0,14,0,0" />
                <ComboBox Name="ChallengeEditorFailureType" DisplayMemberPath="Name" SelectedValuePath="Id"
                          Height="30" Margin="0,6,12,0" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Reward description" Foreground="#E2E8F0" />
                <TextBox Name="ChallengeEditorRewardText" Height="30" Padding="6,3" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Name="ChallengeEditorCancelButton" Content="Cancel" Padding="18,8" />
            <Button Name="ChallengeEditorSaveButton" Content="Save challenge" Padding="18,8" Margin="10,0,0,0"
                    Background="#FFCF55" Foreground="#17202A" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
