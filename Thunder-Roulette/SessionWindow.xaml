<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thunder Roulette Session" Width="720" Height="700" MinWidth="620" MinHeight="600"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" Background="#17202A">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ACTIVE SESSION" Foreground="#FFCF55" FontSize="12" FontWeight="Bold" />
                <TextBlock Name="SessionChallengeName" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,3,0,0" />
                <TextBlock Name="SessionObjective" Foreground="#CBD5E1" FontSize="14" TextWrapping="Wrap" Margin="0,5,20,0" />
            </StackPanel>
            <TextBlock Name="SessionTimer" Grid.Column="1" Text="00:00" Foreground="White" FontSize="24" FontWeight="SemiBold" />
        </Grid>

        <Border Grid.Row="1" Background="#DD0F172A" CornerRadius="12" Padding="14" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Name="SessionNation" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock Name="SessionBR" Foreground="#CBD5E1" Margin="0,4,0,0" />
                    <TextBlock Name="SessionFunMode" Foreground="#38BDF8" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <TextBlock Name="SessionTrack" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock Name="SessionStage" Foreground="#86EFAC" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" />
                    <TextBlock Name="SessionReward" Foreground="#86EFAC" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Name="SessionTrackerScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel Name="SessionTrackerPanel" />
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Session notes" Foreground="#CBD5E1" />
            <TextBox Name="SessionNotes" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="6" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Name="SessionCompletionHint" Text="Complete all required objectives to mark success."
                       Foreground="#94A3B8" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Name="SessionAbandonButton" Content="End session" Padding="14,8" />
                <Button Name="SessionFailedButton" Content="Failed" Padding="14,8" Margin="8,0,0,0" Background="#B91C1C" Foreground="White" />
                <Button Name="SessionSuccessButton" Content="Success" Padding="18,8" Margin="8,0,0,0"
                        Background="#16A34A" Foreground="White" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <Border Name="SessionCampaignCompleteBanner" Grid.RowSpan="5" Panel.ZIndex="20"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                Background="#FFCF55" CornerRadius="14" Padding="24,12"
                Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.85" ScaleY="0.85" CenterX="110" CenterY="25" />
            </Border.RenderTransform>
            <StackPanel>
                <TextBlock Text="CAMPAIGN COMPLETE" Foreground="#17202A" FontSize="20"
                           FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Name="SessionCampaignCompleteText" Foreground="#334155"
                           HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
