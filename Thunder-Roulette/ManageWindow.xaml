<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Thunder Roulette"
        Width="920" Height="680" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="#17202A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl Name="ManageTabs">
            <TabItem Header="Profiles">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox Name="ManageProfileList" DisplayMemberPath="Name" SelectedValuePath="Id" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Name="ManageNewProfileButton" Content="New" Padding="14,7" />
                        <Button Name="ManageRenameProfileButton" Content="Rename" Padding="14,7" Margin="8,0,0,0" />
                        <Button Name="ManageDeleteProfileButton" Content="Delete" Padding="14,7" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,0,0,0">
                        <TextBlock Text="PROFILE SETTINGS" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                        <TextBlock Text="Minimum battle rating" Margin="0,18,0,5" />
                        <ComboBox Name="ManageMinimumBR" Width="100" HorizontalAlignment="Left" ItemStringFormat="{}{0:F1}" />
                        <TextBlock Text="Maximum battle rating" Margin="0,14,0,5" />
                        <ComboBox Name="ManageMaximumBR" Width="100" HorizontalAlignment="Left" ItemStringFormat="{}{0:F1}" />
                        <TextBlock Text="Weapon campaign track" Margin="0,14,0,5" />
                        <ComboBox Name="ManageCampaignTrack" DisplayMemberPath="Name" SelectedValuePath="Id" Height="30" />
                        <TextBlock Text="Current weapon stage" Margin="0,10,0,5" />
                        <ComboBox Name="ManageCampaignStage" DisplayMemberPath="Label" Height="30" />
                        <Button Name="ManageResetBRButton"
                                Content="Reset BR sequence"
                                Padding="14,7"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0" />
                        <CheckBox Name="ManageClearOnExit" Content="Clear nation sequence on exit" Margin="0,20,0,0" />
                        <TextBlock Text="Settings save automatically for the selected profile." Foreground="#64748B" TextWrapping="Wrap" Margin="0,18,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Roll Session">
                <StackPanel Margin="22">
                    <TextBlock Text="ROLL SESSION MODULES" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                    <TextBlock Text="Choose which modules the main ROLL SESSION button includes for this profile. Individual roll buttons are unaffected."
                               TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,20" />
                    <CheckBox Name="SessionRollNation" Content="Roll nation" FontSize="15" Margin="0,0,0,14" />
                    <CheckBox Name="SessionRollBR" Content="Roll battle rating" FontSize="15" Margin="0,0,0,14" />
                    <CheckBox Name="SessionRollChallenge" Content="Draw challenge" FontSize="15" Margin="0,0,0,14" />
                    <CheckBox Name="SessionRollFunMode" Content="Draw fun mode" FontSize="15" />
                    <TextBlock Name="SessionModulesHint"
                               Text="Enable at least one module to use ROLL SESSION."
                               Foreground="#B45309" FontWeight="SemiBold" Margin="0,24,0,0" Visibility="Collapsed" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Progression">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PROGRESSION TRACK" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                            <ComboBox Name="ManageProgressionTrack" DisplayMemberPath="Name" SelectedValuePath="Id"
                                      Height="32" Margin="0,7,12,0" />
                        </StackPanel>
                        <TextBlock Name="ProgressionSourceText" Grid.Column="1" Foreground="#64748B"
                                   VerticalAlignment="Bottom" Margin="0,0,0,7" />
                    </Grid>
                    <ListBox Name="ManageProgressionStageList" Grid.Row="1" DisplayMemberPath="Label" Margin="0,14,0,0" />
                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Name="AddExactStageButton" Content="Add exact" Padding="12,7" />
                        <Button Name="AddRangeStageButton" Content="Add range" Padding="12,7" Margin="8,0,0,0" />
                        <Button Name="EditStageButton" Content="Edit" Padding="12,7" Margin="8,0,0,0" />
                        <Button Name="ToggleStageButton" Content="Enable / disable" Padding="12,7" Margin="8,0,0,0" />
                        <Button Name="MoveStageUpButton" Content="Up" Padding="12,7" Margin="8,0,0,0" />
                        <Button Name="MoveStageDownButton" Content="Down" Padding="12,7" Margin="8,0,0,0" />
                        <Button Name="DeleteStageButton" Content="Delete" Padding="12,7" Margin="8,0,0,0" />
                        <Button Name="RestoreProgressionButton" Content="Restore catalog" Padding="12,7" Margin="8,0,0,0" />
                    </WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="History">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="SESSION HISTORY" FontSize="12" FontWeight="Bold" Foreground="#475569" />
                        <TextBlock Name="ManageHistorySummary" Foreground="#64748B" Margin="0,5,0,0" />
                    </StackPanel>
                    <ListBox Name="ManageHistoryList" Grid.Row="1" Margin="0,12,0,0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,5">
                                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Foreground="#475569" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Attempts}" Foreground="#334155" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Notes}" Foreground="#7C3AED" FontStyle="Italic" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Name="ClearHistoryButton" Grid.Row="2" Content="Clear profile history" Padding="14,7"
                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                </Grid>
            </TabItem>
            <TabItem Header="Challenges">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ListBox Name="ManageChallengeList" DisplayMemberPath="Name" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Name="AddChallengeButton" Content="Add" Padding="14,7" />
                        <Button Name="EditChallengeButton" Content="Edit" Padding="14,7" Margin="8,0,0,0" />
                        <Button Name="DeleteChallengeButton" Content="Delete" Padding="14,7" Margin="8,0,0,0" />
                        <Button Name="ResetChallengeDeckButton" Content="Reset deck" Padding="14,7" Margin="8,0,0,0" />
                        <Button Name="RestoreChallengesButton" Content="Restore defaults" Padding="14,7" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Fun Modes">
                <Grid Margin="16">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ListBox Name="ManageFunModeList" DisplayMemberPath="Name" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Name="AddFunModeButton" Content="Add" Padding="14,7" />
                        <Button Name="EditFunModeButton" Content="Edit" Padding="14,7" Margin="8,0,0,0" />
                        <Button Name="DeleteFunModeButton" Content="Delete" Padding="14,7" Margin="8,0,0,0" />
                        <Button Name="ResetFunModeDeckButton" Content="Reset deck" Padding="14,7" Margin="8,0,0,0" />
                        <Button Name="RestoreFunModesButton" Content="Restore defaults" Padding="14,7" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <Button Name="ManageCloseButton" Grid.Row="1" Content="Done" Padding="24,8" HorizontalAlignment="Right" Margin="0,14,0,0" />
    </Grid>
</Window>
